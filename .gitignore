# Build artifacts
/builds/*
!/builds/.gitkeep
/world/builds/*
!/world/builds/.gitkeep

# Active runtime state
/active/current/*
/active/blue/*
/active/green/*
!/active/blue/.gitkeep
!/active/green/.gitkeep
/active/*.next/
/active/*.previous/
/active/active_version.json
/active/.active_build_id
/active/.last_build_id
/active/.last_validated_build_id
/world/active/current/*
!/world/active/current/.gitkeep

# Data files
/data/*.osm.pbf
/world/data/*.osm.pbf

# Dependencies
/routing-api/node_modules/

# Lock files
/.locks/
/.active_build_id
/.last_build_id
/.last_validated_build_id

# Local secrets and generated reports
/secrets/*.txt
!/secrets/.gitkeep
/reports/*
!/reports/.gitkeep
