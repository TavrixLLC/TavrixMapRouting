VALHALLA_IMAGE=ghcr.io/valhalla/valhalla@sha256:35362dd5f215a8dd6f19b8dab7b41a85cbf0e743e010b7ccf8f5aa984bf565a1
VALHALLA_BLUE_URL=http://valhalla-blue:8002
VALHALLA_GREEN_URL=http://valhalla-green:8002
VALHALLA_IMPORTANT_AREAS=bahrain|Bahrain|50.2,25.5,51.0,26.6
VALHALLA_WORLD_URL=
VALHALLA_MEMORY_LIMIT=2g
VALHALLA_CPU_LIMIT=2.5
VALHALLA_SERVICE_CONCURRENCY=2
VALHALLA_LOG_PATH=/tmp/valhalla-service.log
VALHALLA_HEALTH_LOCATE_JSON=
VALHALLA_HEALTH_ROUTE_JSON=
VALHALLA_ACTIVE_REPLICAS=3
VALHALLA_STANDBY_REPLICAS=1

VALHALLA_REGION=bahrain
VALHALLA_PBF_NAME=gcc-states-latest.osm.pbf
VALHALLA_PBF_URL=https://download.geofabrik.de/asia/gcc-states-latest.osm.pbf
VALHALLA_PBF_PATH=./data/gcc-states-latest.osm.pbf

VALHALLA_CONFIG_PATH=./config/valhalla.json
VALHALLA_REGION_CONFIG_PATH=./config/regions/bahrain.json
ROUTING_REGION_PATH=/app/config/regions/bahrain.json
VALHALLA_BUILDS_PATH=./builds
VALHALLA_ACTIVE_ROOT=./active

VALHALLA_UPDATE_SCHEDULE=daily
VALHALLA_RETENTION_DAYS=14
VALHALLA_TIMEOUT_MS=10000
VALHALLA_DNS_TTL_MS=30000
ROUTING_INCLUDE_RAW=false
ROUTING_ALLOW_REQUEST_RAW=false
ROUTING_ACCESS_LOG=false
ROUTING_LOAD_MAX_SOCKETS=16
ROUTING_PUBLIC_PORT=8080
ROUTING_API_MEMORY_LIMIT=512m
ROUTING_API_CPU_LIMIT=1.5
ROUTING_PROXY_CPU_LIMIT=1.0
ROUTING_STANDARD_RATE_LIMIT=250
ROUTING_EXPENSIVE_RATE_LIMIT=10
ROUTING_UPDATER_MEMORY_LIMIT=6g
ROUTING_UPDATER_CPU_LIMIT=4.0
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD_FILE=./secrets/grafana_admin_password.txt

# Optional external check. This repo does not deploy the geocoder.
# GEOCODER_FIXTURE_URL should return a real geocoder response containing routable_point.
GEOCODER_FIXTURE_URL=
GEOCODER_BASE_URL=
GEOCODER_QUERY_TEXT=Manama, Bahrain
GEOCODER_FOCUS_LAT=26.2235
GEOCODER_FOCUS_LON=50.5876
EXPECTED_COUNTRY=BH
ALLOW_CENTER_FALLBACK=false
