{
  "logging": {
    "type": "std_out",
    "color": false
  },
  "mjolnir": {
    "tile_dir": "/valhalla/build",
    "tile_extract": "/valhalla/build/valhalla_tiles.tar",
    "timezone": "/valhalla/build/timezones.sqlite",
    "admin": "/valhalla/build/admins.sqlite",
    "hierarchy": true,
    "shortcuts": true,
    "include_driveways": true,
    "include_construction": false,
    "include_bicycle": true,
    "include_pedestrian": true,
    "include_driving": true,
    "data_processing": {
      "use_admin_db": false,
      "scan_tar": false
    }
  },
  "additional_data": {
    "elevation": "/data/valhalla/elevation/"
  },
  "loki": {
    "actions": [
      "locate",
      "route",
      "height",
      "sources_to_targets",
      "optimized_route",
      "isochrone",
      "trace_route",
      "trace_attributes",
      "status"
    ],
    "use_connectivity": true,
    "service_defaults": {
      "radius": 0,
      "minimum_reachability": 50,
      "search_cutoff": 35000
    },
    "service": {
      "proxy": "ipc:///tmp/loki"
    }
  },
  "thor": {
    "source_to_target_algorithm": "select_optimal",
    "service": {
      "proxy": "ipc:///tmp/thor"
    },
    "max_reserved_labels_count_astar": 2000000,
    "max_reserved_labels_count_bidir_astar": 1000000,
    "max_reserved_labels_count_dijkstras": 4000000,
    "max_reserved_labels_count_bidir_dijkstras": 2000000,
    "clear_reserved_memory": false
  },
  "odin": {
    "service": {
      "proxy": "ipc:///tmp/odin"
    },
    "markup_formatter": {
      "markup_enabled": false
    }
  },
  "meili": {
    "mode": "auto",
    "service": {
      "proxy": "ipc:///tmp/meili"
    },
    "customizable": [
      "mode",
      "search_radius",
      "turn_penalty_factor",
      "gps_accuracy",
      "interpolation_distance",
      "sigma_z",
      "beta",
      "max_route_distance_factor",
      "max_route_time_factor"
    ]
  },
  "httpd": {
    "service": {
      "listen": "tcp://*:8002",
      "loopback": "ipc:///tmp/loopback",
      "interrupt": "ipc:///tmp/interrupt",
      "drain_seconds": 28,
      "shutdown_seconds": 1,
      "timeout_seconds": -1
    }
  },
  "service_limits": {
    "auto": {
      "max_distance": 5000000.0,
      "max_locations": 25,
      "max_matrix_distance": 400000.0,
      "max_matrix_location_pairs": 625
    },
    "pedestrian": {
      "max_distance": 250000.0,
      "max_locations": 25,
      "max_matrix_distance": 200000.0,
      "max_matrix_location_pairs": 625
    },
    "bicycle": {
      "max_distance": 500000.0,
      "max_locations": 25,
      "max_matrix_distance": 200000.0,
      "max_matrix_location_pairs": 625
    },
    "motor_scooter": {
      "max_distance": 500000.0,
      "max_locations": 25,
      "max_matrix_distance": 200000.0,
      "max_matrix_location_pairs": 625
    },
    "truck": {
      "max_distance": 5000000.0,
      "max_locations": 25,
      "max_matrix_distance": 400000.0,
      "max_matrix_location_pairs": 625
    },
    "bus": {
      "max_distance": 5000000.0,
      "max_locations": 25,
      "max_matrix_distance": 400000.0,
      "max_matrix_location_pairs": 625
    },
    "taxi": {
      "max_distance": 5000000.0,
      "max_locations": 25,
      "max_matrix_distance": 400000.0,
      "max_matrix_location_pairs": 625
    },
    "isochrone": {
      "max_contours": 4,
      "max_time_contour": 120,
      "max_distance": 25000.0,
      "max_locations": 2,
      "max_distance_contour": 200
    },
    "trace": {
      "max_distance": 200000.0,
      "max_gps_accuracy": 100.0,
      "max_search_radius": 100.0,
      "max_shape": 500,
      "max_alternates": 1
    },
    "status": {
      "allow_verbose": false
    }
  }
}
